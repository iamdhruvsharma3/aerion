{
  "name": "aerion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-node.mjs scripts/dev.ts",
    "build": "node scripts/run-node.mjs node_modules/next/dist/bin/next build",
    "start": "node scripts/run-node.mjs node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write .",
    "db:migrate": "tsx scripts/migrate.ts",
