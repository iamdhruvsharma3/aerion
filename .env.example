# Run npm run db:migrate after setting a dedicated database.
DATABASE_URL=postgresql:///aerion_local?host=/tmp

# Explicitly development-only. Refused by the production server and non-loopback hosts.
AERION_LOCAL_AUTH=true

# For authenticated hosting: disable AERION_LOCAL_AUTH and configure Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact browser origin when hosting behind a reverse proxy, e.g. https://aerion.example
AERION_APP_ORIGIN=

# Optional AI extraction. Both are required; no default model or automatic spending.
# The selected model must support Responses API structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional NVIDIA-hosted Nemotron 3 Ultra. Key stays server-side.
# Obtain a key for this model from NVIDIA Build; restart web and worker after adding it.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional public web discovery. Separate from the Brave browser and NVIDIA account.
# One Brave Search API query per discovery run; public URL inspection works without it.
BRAVE_SEARCH_API_KEY=

# Optional local AI reasoning/extraction. Install/pull a tool-capable model separately.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional additional trusted PEM CA for public-source collection on managed networks.
# Certificate verification stays enabled; obtain the PEM from your trusted administrator.
AERION_EXTRA_CA_FILE=

# Optional business mail, bound to one authenticated founder UUID when hosted.
# Local auth automatically binds to the development founder if this is blank.
AERION_MAIL_OWNER_ID=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_FOLDER=
# Use a provider app password OR an OAuth access token, not both.
IMAP_PASSWORD=
IMAP_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=
SMTP_ACCESS_TOKEN=
